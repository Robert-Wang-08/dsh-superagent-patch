From 822e634873cfb12600632b325e7fbd01885ab172 Mon Sep 17 00:00:00 2001
From: Robert-Wang-08 <70126004+Robert-Wang-08@users.noreply.github.com>
Date: Mon, 16 Nov 2026 09:31:53 +0800
Subject: [PATCH 5/5] fix(worker): enable child model selection in the worker
 preset

The worker preset's `tool-subagent` row set `modelSelection: true` and
`modelDiscovery: true`; neither key exists in the tool's config schema, so the
row mounted with `modelSelectionSettings` at its default `false`. An Executor
Session's `subagent` tool therefore had no `provider`, `model` or
`reasoning_effort` fields, and passing them failed with "child model selection
is disabled for this tool instance".

Set `modelSelectionSettings: true` so a worker can route a delegated review to
another provider/model within the routes the Host's
`subagent-model-selection-settings` records for its Session, and drop the
ignored keys. The regression test reads the bundle patch the way DSH does and
fails on the previous config.
---
 cordis.patch.yml                  |  8 ++++++--
 docs/006-deployment.md            |  2 +-
 examples/profile.cordis.patch.yml |  9 +++++++++
 tests/bundle-patch.spec.ts        | 10 ++++++++--
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/cordis.patch.yml b/cordis.patch.yml
index 5ada6df..1e678f3 100644
--- a/cordis.patch.yml
+++ b/cordis.patch.yml
@@ -101,13 +101,17 @@
             config:
               - id: tool-subagent-control
                 name: '@deepseek-ai/dsh-tool-subagent-control'
+              # `modelSelectionSettings` is the only key that turns on child model selection; the tool
+              # then also exposes `provider`, `model` and `reasoning_effort`, restricted to the routes
+              # the Host's `subagent-model-selection-settings` records for the Session. A typo here
+              # (e.g. `modelSelection`) leaves the tool without those fields, so a worker cannot route
+              # an independent review to another provider/model.
               - id: tool-subagent
                 name: '@deepseek-ai/dsh-tool-subagent'
                 config:
                   provider: spawn
                   toolName: subagent
-                  modelSelection: true
-                  modelDiscovery: true
+                  modelSelectionSettings: true
                   agentPreset: standard
           - id: tool-todo
             name: '@deepseek-ai/dsh-tool-todo'
